{
  "name": "shangmeng-system",
  "version": "0.1.0",
  "private": true,
  "description": "商盟系统：NestJS 后端 + Vue3 管理后台 + uni-app 小程序",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run start:dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:seed": "npm run prisma:seed -w server",
    "prisma:studio": "npm run prisma:studio -w server",
    "db:reset": "docker compose exec -T server npm run prisma:seed",
    "build:mp-weixin": "npm run build:mp-weixin --prefix web-mini",
    "dev:mp-weixin": "npm run dev:mp-weixin --prefix web-mini"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
